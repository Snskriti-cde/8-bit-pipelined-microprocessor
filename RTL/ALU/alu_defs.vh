`ifndef ALU_DEFS_VH
`define ALU_DEFS_VH

`define ALU_ADD  5'h00
`define ALU_SUB  5'h01
`define ALU_AND  5'h02
`define ALU_OR   5'h03
`define ALU_XOR  5'h04
`define ALU_NOT  5'h05
`define ALU_PASA 5'h06
`define ALU_NOR  5'h07
`define ALU_SLT  5'h08
`define ALU_SLL  5'h09
`define ALU_SRL  5'h0A
`define ALU_SRA  5'h0B
`define ALU_ROL  5'h0C
`define ALU_ROR  5'h0D
`define ALU_INC  5'h0E
`define ALU_DEC  5'h0F
`define ALU_MUL  5'h10
`define ALU_DIV  5'h11

`endif